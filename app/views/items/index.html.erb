<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Items</h1>
    <%= link_to 'New item', new_item_path, class: 'rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium' %>
  </div>
  <div id="items" class="min-w-full">
    <% @items.each do |item| %>
      <img class="w-1/3 display: inline-block mr-5" src="<%= item.image %>">
      <div class="w-1/3 display: inline-block float-right mr-5">
        <p class="my-5">
          <strong class="block font-medium mb-1">Description:</strong>
          <%= item.description %>
        </p>
        <p class="my-5">
          <strong class="block font-medium mb-1">Quantity:</strong>
          <%= item.quantity %>
        </p>
        <% if action_name != "show" %>
          <%= link_to 'Show this item', item, class: 'rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium' %>
          <%= link_to 'Edit this item', edit_item_path(item),
                class: 'rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium' %>
          <hr class="mt-6">
        <% end %>
      </div>
    <% end %>
  </div>
</div>
