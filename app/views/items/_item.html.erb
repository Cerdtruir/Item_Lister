<div id="<%= dom_id item %>">
  <p>
    <strong>Name:</strong>
    <%= item.name %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= item.description %>
  </p>

  <p>
    <strong>Condition:</strong>
    <%= item.condition %>
  </p>

  <p>
    <strong>Quantity:</strong>
    <%= item.quantity %>
  </p>

  <p>
    <strong>Cost price:</strong>
    <%= item.cost_price %>
  </p>

  <p>
    <strong>Selling price:</strong>
    <%= item.selling_price %>
  </p>

  <p>
    <strong>Image:</strong>
    <%= item.image %>
  </p>

</div>
