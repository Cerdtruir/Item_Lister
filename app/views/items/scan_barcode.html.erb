<div class="w-full">
  <h1 class="text-2xl font-bold mb-4">Scan Barcode</h1>
  <% if flash[:alert] %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
      <span class="block sm:inline"><%= flash[:alert] %></span>
    </div>
  <% end %>
  <div id="interactive" class="viewport"></div>
  <%= form_with url: create_from_barcode_items_path, method: :post, id: 'barcode-form' do |form| %>
    <%= form.hidden_field :barcode, id: 'barcode-input' %>
  <% end %>
  <div class="mt-4">
    <p>Status: <span id="status">Initializing...</span></p>
    <p>Detected Barcode: <span id="detected-barcode">None</span></p>
  </div>
</div>
<style>
  .viewport {
    width: 100%;
    max-width: 640px;
    height: auto;
    position: relative;
  }

  .viewport video, .viewport canvas {
    width: 100%;
    height: auto;
  }

  .viewport canvas.drawingBuffer {
    position: absolute;
    top: 0;
    left: 0;
  }
</style>
<script type="text/javascript">
  document.addEventListener('turbo:load', function() {
    const statusEl = document.getElementById('status');
    const barcodeEl = document.getElementById('detected-barcode');

    if (navigator.mediaDevices === undefined || navigator.mediaDevices.getUserMedia === undefined) {
      const message = "Camera access is not available in your browser. This feature requires a secure connection (HTTPS) or localhost.";
      statusEl.textContent = message;
      return;
    }

    statusEl.textContent = 'Starting camera...';

    Quagga.init({
      inputStream : {
        name : "Live",
        type : "LiveStream",
        target: document.querySelector('#interactive'),
        constraints: {
          width: 640,
          height: 480,
          facingMode: { ideal: "environment" }
        },
      },
      decoder : {
        readers : ["ean_reader", "code_128_reader", "upc_reader"]
      }
    }, function(err) {
        if (err) {
            console.log(err);
            let errorMessage = `Error: ${err.message}.`;
            if (err.name === "NotFoundError") {
              errorMessage += " Could not find a camera. Please ensure one is connected and permissions are allowed.";
            }
            statusEl.textContent = errorMessage;
            return
        }
        statusEl.textContent = 'Camera started. Ready to scan.';
        Quagga.start();
    });

    Quagga.onDetected(function(result) {
      const code = result.codeResult.code;
      barcodeEl.textContent = code;
      document.getElementById('barcode-input').value = code;
      document.getElementById('barcode-form').submit();
      Quagga.stop();
    });
  });
</script>
