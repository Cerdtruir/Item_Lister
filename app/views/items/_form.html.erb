<%= form_with(model: item, class: 'contents') do |form| %>
  <% if item.errors.any? %>
    <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);border-radius:0.75rem;padding:0.75rem 1rem;margin-bottom:1rem;color:#f87171;font-size:0.875rem;">
      <strong><%= pluralize(item.errors.count, 'error') %> prohibited this item from being saved:</strong>
      <ul style="margin:0.5rem 0 0 1rem;">
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="detail-field">
    <label class="input-label" for="item_name">Name</label>
    <%= form.text_field :name, class: 'input-glow', id: 'item_name' %>
  </div>

  <div class="detail-grid">
    <div class="detail-field">
      <label class="input-label" for="item_selling_price">Selling Price (R)</label>
      <%= form.text_field :selling_price, class: 'input-glow', id: 'item_selling_price' %>
    </div>
    <div class="detail-field">
      <label class="input-label" for="item_original_price">Original Price (R)</label>
      <%= form.text_field :original_price, class: 'input-glow', id: 'item_original_price' %>
    </div>
  </div>

  <div class="detail-grid">
    <div class="detail-field">
      <label class="input-label" for="item_cost_price">Cost Price (R)</label>
      <%= form.text_field :cost_price, class: 'input-glow', id: 'item_cost_price' %>
    </div>
    <div class="detail-field">
      <label class="input-label" for="item_quantity">Quantity</label>
      <%= form.number_field :quantity, class: 'input-glow', id: 'item_quantity' %>
    </div>
  </div>

  <div class="detail-grid">
    <div class="detail-field">
      <label class="input-label" for="item_external_stock">External Stock</label>
      <%= form.number_field :external_stock, class: 'input-glow', id: 'item_external_stock' %>
    </div>
    <div class="detail-field">
      <label class="input-label" for="item_condition">Condition</label>
      <%= form.select :condition, Item::CONDITIONS, { prompt: 'Select Condition' }, class: 'input-glow', id: 'item_condition' %>
    </div>
  </div>

  <div class="detail-field">
    <label class="input-label" for="item_category">Category</label>
    <%= form.select :category, Item::CATEGORIES, { prompt: 'Select Category' }, class: 'input-glow', id: 'item_category' %>
  </div>

  <div class="detail-field">
    <label class="input-label" for="item_description">Description</label>
    <%= form.text_area :description, rows: 3, class: 'input-glow', id: 'item_description', style: 'resize:vertical;' %>
  </div>

  <div class="detail-field">
    <label class="input-label" for="item_takealot_url">Takealot URL</label>
    <%= form.text_field :takealot_url, class: 'input-glow', id: 'item_takealot_url' %>
  </div>

  <div class="detail-field">
    <label class="input-label" for="item_barcode">Barcode</label>
    <%= form.text_field :barcode, class: 'input-glow', id: 'item_barcode' %>
  </div>

  <div class="detail-field">
    <label class="input-label" for="item_image">Image URL</label>
    <%= form.text_field :image, class: 'input-glow', id: 'item_image' %>
  </div>

  <!-- Platform Listing Status -->
  <div style="margin-top:1.25rem;padding:1rem;background:rgba(30,41,59,0.4);border:1px solid rgba(148,163,184,0.1);border-radius:0.75rem;">
    <div style="font-size:0.75rem;font-weight:600;color:rgba(148,163,184,0.6);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:0.75rem;">Platform Listing Status</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.75rem;">
      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.85rem;color:rgba(226,232,240,0.8);">
        <%= form.check_box :listed_on_takealot, style: 'width:16px;height:16px;accent-color:#f59e0b;cursor:pointer;' %>
        <span style="color:#f59e0b;font-weight:600;">Takealot</span>
      </label>
      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.85rem;color:rgba(226,232,240,0.8);">
        <%= form.check_box :listed_on_woocommerce, style: 'width:16px;height:16px;accent-color:#a78bfa;cursor:pointer;' %>
        <span style="color:#a78bfa;font-weight:600;">WooCommerce</span>
      </label>
      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.85rem;color:rgba(226,232,240,0.8);">
        <%= form.check_box :listed_on_amazon, style: 'width:16px;height:16px;accent-color:#34d399;cursor:pointer;' %>
        <span style="color:#34d399;font-weight:600;">Amazon.co.za</span>
      </label>
      <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.85rem;color:rgba(226,232,240,0.8);">
        <%= form.check_box :listed_on_zoho, style: 'width:16px;height:16px;accent-color:#38bdf8;cursor:pointer;' %>
        <span style="color:#38bdf8;font-weight:600;">Zoho</span>
      </label>
    </div>
    <% if item.persisted? %>
      <div style="margin-top:0.75rem;display:grid;grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));gap:0.5rem;font-size:0.7rem;color:rgba(148,163,184,0.5);">
        <div>Offer ID: <%= item.takealot_offer_id.presence || '—' %></div>
        <div>WC ID: <%= item.woocommerce_product_id.presence || '—' %></div>
        <div>ASIN: <%= item.amazon_asin.presence || '—' %></div>
        <div>Zoho ID: <%= item.zoho_item_id.presence || '—' %></div>
      </div>
      <% if item.last_synced_at %>
        <div style="margin-top:0.4rem;font-size:0.7rem;color:rgba(148,163,184,0.4);">Last synced: <%= item.last_synced_at.strftime('%d %b %Y %H:%M') %></div>
      <% end %>
    <% end %>
  </div>

  <div style="margin-top:1.25rem;">
    <%= form.submit class: 'btn-primary-glow', style: 'cursor:pointer;' %>
  </div>
<% end %>

